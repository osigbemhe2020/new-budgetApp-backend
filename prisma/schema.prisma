//schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userId       Int      @id @default(autoincrement())
  username     String
  email        String   @unique
  password_hash String
  created_at   DateTime @default(now())

  @@map("user_info")
}
